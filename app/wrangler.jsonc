// Cloudflare Worker: serves the built app from ./dist and the /api/* backend (D1 database).
// Deploy from app/: `npm run deploy`. Local backend: `npm run dev:api` (uses a local D1 copy).
{
  "name": "ap-learning",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ap-learning",
      "database_id": "cfdddd91-4cbf-4b16-94c1-6ee285d15361",
      "migrations_dir": "worker/migrations"
    }
  ],
  "vars": {
    "GOOGLE_CLIENT_ID": "1066207111886-bgdealh7knhf47b8kpetallaqi4d0587.apps.googleusercontent.com",
    "OWNER_EMAIL": "devt309@gmail.com"
  },
  // Request limits per network address, per minute, on /api/* (see rateLimit in worker/index.ts).
  // A school shares one address between a whole class, so these are sized for a classroom.
  "ratelimits": [
    { "name": "RL_API", "namespace_id": "1001", "simple": { "limit": 600, "period": 60 } },
    { "name": "RL_AUTH", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_PUBLIC", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } }
  ],
  // Stripe (set once with `npx wrangler secret put STRIPE_SECRET_KEY` and `... STRIPE_WEBHOOK_SECRET`;
  // until then paid plans show "Coming soon").
  "observability": { "enabled": true },
  // The address also lives in shared/brand.ts (domain); keep the two in step. The old aplearning.app
  // addresses stay attached so their links redirect to eziq.app (OLD_DOMAINS in shared/brand.ts).
  "routes": [
    { "pattern": "www.eziq.app", "custom_domain": true },
    { "pattern": "eziq.app", "custom_domain": true },
    { "pattern": "admin.eziq.app", "custom_domain": true },
    { "pattern": "www.aplearning.app", "custom_domain": true },
    { "pattern": "aplearning.app", "custom_domain": true },
    { "pattern": "admin.aplearning.app", "custom_domain": true }
  ]
}
