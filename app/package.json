{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "dev:api": "wrangler d1 migrations apply ap-learning --local && wrangler dev --port 8787",
    "deploy": "vitest run && tsc -b && vite build && wrangler d1 migrations apply ap-learning --remote && wrangler deploy"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261009.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
